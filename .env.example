# --- Database -------------------------------------------------------------
# SQLite for dev. Postgres-portable conventions are used throughout the schema.
DATABASE_URL=file:./data/app.db

# --- Blob storage ---------------------------------------------------------
# local (default) | s3. Local disk is a real deployment, not a demo.
# STORAGE_DRIVER=local
# LocalDiskStore root. Keys are prefixed memorial/{id}/ so a hard delete can
# purge by prefix.
STORAGE_DIR=./data/blobs

# S3-compatible object storage (STORAGE_DRIVER=s3). Needs the optional
# @aws-sdk/client-s3 package. The bucket must be private: this product never
# hands out a public or presigned URL, because a presigned link outlives a
# revoked viewing link. See docs/production.md.
# S3_BUCKET=celebration-blobs
# S3_REGION=eu-west-1
# Anything that is not AWS (MinIO, Backblaze B2, R2, Wasabi):
# S3_ENDPOINT=https://s3.example.com
# S3_FORCE_PATH_STYLE=1
# Sharing a bucket with something else:
# S3_KEY_PREFIX=prod
# Omit both to use the machine's own role/credentials.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Media ----------------------------------------------------------------
# ffmpeg/ffprobe must be on PATH. Override here if they live somewhere else.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# --- Rendering ------------------------------------------------------------
# Remotion drives a headless Chromium. Any Chromium already on the machine is
# found automatically (Playwright/Puppeteer caches, /usr/bin/chromium); set this
# to settle the question outright, or to point at a build you trust. With none
# available and no network to remotion.media, renders fail with an explanation
# rather than silently.
# REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium

# --- AI -------------------------------------------------------------------
# Global provider: mock | claude-cli | codex-cli | anthropic-api | openai-api.
# `pnpm ai:doctor` checks whatever this is set to. Full reference, including
# what each adapter can do: docs/ai-providers.md
AI_PROVIDER=mock
# Per-task overrides (optional). VISION covers photo analysis, EDL covers
# slideshow ordering, CAPTION covers drafted copy — which includes the eulogy
# studio and the printed program's life sketch.
# AI_PROVIDER_INTERVIEW=claude-cli
# AI_PROVIDER_VISION=openai-api
# AI_PROVIDER_EDL=claude-cli
# AI_PROVIDER_CAPTION=claude-cli
# Canned responses for the mock provider.
AI_FIXTURES_DIR=./fixtures/ai

# claude-cli — install Claude Code and run `claude` once to sign in.
# CLAUDE_CLI_PATH=claude
# AI_MODEL_CLAUDE_CLI=

# codex-cli — install the Codex CLI and run `codex login`. Image support is
# probed once from `codex exec --help`; set this to 1/0 to state it instead.
# CODEX_CLI_PATH=codex
# AI_CODEX_VISION=

# Shared CLI timeout. A hung CLI must never hang the worker.
# AI_CLI_TIMEOUT_MS=120000

# anthropic-api
# ANTHROPIC_API_KEY=
# AI_MODEL_ANTHROPIC=claude-opus-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# openai-api. OPENAI_BASE_URL is honoured, so this also reaches Ollama, vLLM or
# LM Studio — a local server usually needs no key at all.
# OPENAI_API_KEY=
# AI_MODEL_OPENAI=gpt-5
# OPENAI_BASE_URL=https://api.openai.com
# response_format: json_schema is opt-in, because compatible servers vary.
# OPENAI_JSON_SCHEMA=

# Shared HTTP timeout for the two API adapters.
# AI_HTTP_TIMEOUT_MS=120000

# Run the shared adapter contract suite against real providers (never in CI):
#   AI_LIVE_TEST=1 pnpm vitest run --project ai
# AI_LIVE_TEST=
# AI_LIVE_TEST_PROVIDERS=claude-cli

# --- Web ------------------------------------------------------------------
PORT=3000
# Public base URL used when composing magic links / contributor links. It has to
# be absolute: the link is read in an email client, not in the browser tab that
# made it.
APP_BASE_URL=http://localhost:3000
# Signs the httpOnly session cookie (HMAC-SHA256). Any long random string will
# do — `openssl rand -base64 48`. Development falls back to an insecure default
# and warns; production refuses to start without it. Changing it signs everyone
# out, which is a safe thing to do.
# SESSION_SECRET=
# Derives shareable collection/contributor links. The database stores only the
# hash, so an organiser can be shown their link again — including the printed QR
# code — without the plaintext ever being written down. Defaults to
# SESSION_SECRET. Changing it turns every existing collection link off, so set
# it once, alongside SESSION_SECRET, and leave it alone.
# LINK_SECRET=

# --- Email ----------------------------------------------------------------
# console (default) | resend. The console transport prints the magic link to the
# server log and shows it on screen, so the product is walkable without an
# inbox. In production with a real transport, messages go through the job queue
# instead of the request — a mail outage becomes a delay, not a 500.
# MAIL_TRANSPORT=console
# RESEND_API_KEY=
# MAIL_FROM=Celebration of Life <hello@example.com>
# SMTP is not implemented; see docs/production.md for what adding it involves.

# --- Worker ---------------------------------------------------------------
WORKER_POLL_INTERVAL_MS=1500
WORKER_LEASE_MS=30000
# Retries before a job is parked as failed.
WORKER_MAX_ATTEMPTS=3
# Identifies the lease holder in jobs.locked_by. Defaults to host-pid.
# WORKER_ID=laptop
# Restrict this process to certain job types, e.g. a render-only box.
# WORKER_JOB_TYPES=render

# --- Logging --------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info

# --- Song search ----------------------------------------------------------
# The "their song" screen can search Apple's iTunes catalogue and play a
# half-minute preview, so a family can be sure which recording they mean. There
# is nothing to configure: the endpoint (https://itunes.apple.com/search) takes
# no key and no account, the search runs server-side, and results are held in
# memory for a few minutes rather than stored.
#
# If outbound access to itunes.apple.com is blocked — an air-gapped install, a
# strict egress policy — nothing breaks: the screen says so in one sentence and
# the organiser types the song's name, which was always allowed. Previews are
# never downloaded, never mixed into the video and never timed to; the video in
# this mode stays silent by design (see docs/adr/0002-render-and-music.md).

# --- Deploying ------------------------------------------------------------
# `pnpm start:prod` runs migrations, seeds the music library, then supervises
# the web app and the worker as one process — because they share one SQLite
# file and one blob directory and so must sit on one machine. The container
# image (Dockerfile), the VPS setup (docker-compose.yml + deploy/Caddyfile),
# fly.toml and railway.json all start it the same way. The walkthrough, which
# takes about fifteen minutes, is docs/deploy.md.
#
# The image already sets these, so the only things left to set are the two
# secrets above and APP_BASE_URL:
#   NODE_ENV=production
#   DATABASE_URL=file:/data/app.db
#   STORAGE_DIR=/data/blobs
#   REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium
#
# Which domain Caddy should get a certificate for (docker-compose.yml only).
# COL_DOMAIN=remembering-jean.example.com
#
# Stopping. The first SIGTERM asks the worker to finish the job it is holding.
# After this long it is asked again, which abandons that job — the lease
# expires and the next worker to start picks it up.
# COL_SHUTDOWN_GRACE_MS=25000
# COL_SHUTDOWN_HARD_MS=10000
#
# Crash-looping. After this many restarts of either child inside the window,
# the supervisor stops everything and exits non-zero, so the platform restarts
# the whole container rather than papering over it forever.
# COL_MAX_RESTARTS=5
# COL_RESTART_WINDOW_MS=60000
